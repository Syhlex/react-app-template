{
  "name": "react-app-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "clear": "npm run clear:build && npm run clear:modules",
    "clear:build": "rm -rf build",
    "clear:modules": "rm -rf node_modules",
    "setup:hooks": "git config core.hooksPath git-hooks"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "~3.5.3",
    "sass": "^1.38.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vite-plugin-sass-dts": "^1.3.37",
    "vitest": "^5.0.3"
  }
}
